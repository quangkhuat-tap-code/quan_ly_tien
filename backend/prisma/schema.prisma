generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// 1. Bảng Người dùng
model Users {
  id           Int            @id @default(autoincrement())
  email        String         @unique
  password     String
  name         String?
  createdAt    DateTime       @default(now())

  // Mối quan hệ: 1 User có nhiều Ví, Danh mục, Giao dịch
  wallets      Wallets[]
  categories   Categories[]
  transactions Transactions[]
}

// 2. Bảng Ví tiền
model Wallets {
  id           Int            @id @default(autoincrement())
  name         String
  balance      Decimal        @default(0) @db.Decimal(12, 2)
  userId       Int
  createdAt    DateTime       @default(now())

  user         Users          @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions Transactions[]
}

// 3. Bảng Danh mục thu/chi
model Categories {
  id           Int            @id @default(autoincrement())
  name         String
  type         String         // 'EXPENSE' (Chi) hoặc 'INCOME' (Thu)
  userId       Int

  user         Users          @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions Transactions[]
}

// 4. Bảng Giao dịch (Khoản thu / chi cụ thể)
model Transactions {
  id              Int        @id @default(autoincrement())
  amount          Decimal    @db.Decimal(12, 2)
  note            String?
  transactionDate DateTime   @default(now())
  userId          Int
  walletId        Int
  categoryId      Int
  createdAt       DateTime   @default(now())

  // Khóa ngoại liên kết ngược lại 3 bảng trên
  user            Users      @relation(fields: [userId], references: [id], onDelete: Cascade)
  wallet          Wallets    @relation(fields: [walletId], references: [id], onDelete: Cascade)
  category        Categories @relation(fields: [categoryId], references: [id], onDelete: Cascade)
}